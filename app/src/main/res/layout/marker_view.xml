<?xml version="1.0" encoding="utf-8"?>
<!--
    Place this file at: app/src/main/res/layout/marker_view.xml
    Used by TemperatureMarkerView in ForecastChartUI.kt to render the
    tap-to-inspect tooltip bubble over the chart.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/marker_background"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
